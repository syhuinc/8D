<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Visualizer, to measure our own output (granted by the test over adb). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- To hand a song to 8D Converter, like a file manager or chat app would. -->
    <queries>
        <package android:name="io.github.syhuinc.eightd" />
    </queries>

    <application android:label="8D Test Player">
        <activity android:name=".PlayerActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Shares a generated song with 8D Converter (ACTION_SEND), through SongProvider. -->
        <activity android:name=".ShareActivity" android:exported="true" />
        <provider
            android:name=".SongProvider"
            android:authorities="io.github.syhuinc.eightd.testplayer.songs"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
